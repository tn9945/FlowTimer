<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
<Button android:id="@+id/btnStats" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_button_stats" android:backgroundTint="@color/flow_button_stats" android:text="통계" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"/>
<Button android:id="@+id/btnStartFocus" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginHorizontal="6dp" android:layout_weight="1.8" android:background="@drawable/bg_button_focus" android:backgroundTint="@color/flow_button_focus" android:text="집중 시작" android:textAllCaps="false" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold"/>
<Button android:id="@+id/btnMemo" android:layout_width="0dp" android:layout_height="62dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_button_detail" android:backgroundTint="@color/flow_button_detail" android:text="메모" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold"/>
</LinearLayout>
<Button android:id="@+id/btnResetFocus" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button_orange" android:backgroundTint="@color/flow_button_game" android:text="일시정지" android:textAllCaps="false" android:textColor="@color/white" android:visibility="gone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:orientation="horizontal">
<Button android:id="@+id/btnWeeklyReport" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_button_detail" android:backgroundTint="@color/flow_button_detail" android:text="주간 리포트" android:textAllCaps="false" android:textColor="@color/white" android:textSize="14sp"/>
<Button android:id="@+id/btnPermissionStatus" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_button_developer" android:backgroundTint="@color/flow_button_developer" android:text="권한 설정" android:textAllCaps="false" android:textColor="@color/white" android:textSize="14sp"/>
</LinearLayout>
</LinearLayout>
